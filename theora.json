{
    "name": "theora",
    "description": "Theora decoder",
    "filters":["theoradec"],
    "help": "This filter decodes Theora streams through libtheora library.",
    "support": [
        "video"
    ],
    "sources":"https://codeload.github.com/Bevara/theora/zip/refs/heads/main",
    "filter_source":{
        "theoradec" : "dec_theora.c"
    },
    "Format": ["Theora"],
    "licence_required":false,
    "using": ["solver_minimal_1", "solver_1"],
    "runtime": {
        "theoradec": {
            "outputs": [
                {
                    "property": "GF_PROP_PID_PIXFMT",
                    "format": [
                        "GF_PIXEL_YUV422",
                        "GF_PIXEL_YUV444",
                        "GF_PIXEL_YUV"
                    ]
                }
            ]
        }
    }
}
